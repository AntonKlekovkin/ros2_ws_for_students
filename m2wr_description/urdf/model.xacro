<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_drive_robot">

    <!-- ==================== КОНФИГУРАЦИЯ ПАРАМЕТРОВ ==================== -->
    <!-- Все размеры в метрах, массы в кг, углы в радианах -->

    <!-- Размеры базы (коробка) -->
    <xacro:property name="base_length" value="0.5"/>
    <xacro:property name="base_width" value="0.3"/>
    <xacro:property name="base_height" value="0.15"/>
    <xacro:property name="base_mass" value="5.0"/>
    
    <!-- Размеры колес -->
    <xacro:property name="wheel_radius" value="0.095"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_mass" value="0.5"/>
    
    <!-- Позиции колес -->
    <xacro:property name="wheel_x_offset" value="0.15"/>
    <xacro:property name="wheel_y_offset" value="${base_width/2 + wheel_width/2}"/>
    <xacro:property name="wheel_z_offset" value="${-base_height/4}"/>
    
    <!-- Размеры лидара -->
    <xacro:property name="lidar_radius" value="0.05"/>
    <xacro:property name="lidar_height" value="0.04"/>
    <xacro:property name="lidar_mass" value="0.15"/>
    <xacro:property name="lidar_x_offset" value="0.1"/>
    <xacro:property name="lidar_z_offset" value="${base_height/2 + lidar_height/2}"/>
    
    <!-- Параметры лидара -->
    <xacro:property name="lidar_samples" value="180"/>
    <xacro:property name="lidar_min_range" value="0.12"/>
    <xacro:property name="lidar_max_range" value="10.0"/>
    <xacro:property name="lidar_update_rate" value="20"/>
    
    <!-- Параметры дифференциального привода -->
    <xacro:property name="wheel_separation" value="${base_width + wheel_width}"/>
    <xacro:property name="max_linear_velocity" value="0.5"/>
    <xacro:property name="max_angular_velocity" value="1.0"/>
    <xacro:property name="odom_publish_frequency" value="50"/>

    <!-- ==================== БАЗОВОЕ ЗВЕНО ==================== -->
    <link name="base_footprint"></link>
    <joint name="base_joint" type="fixed">
        <origin xyz="${-wheel_x_offset} 0 ${-wheel_z_offset + wheel_radius}" rpy="0 0 0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>        
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.4 0.8 1.0"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${base_mass}"/>
            <inertia 
                ixx="${base_mass * (base_width*base_width + base_height*base_height) / 12}"
                iyy="${base_mass * (base_length*base_length + base_height*base_height) / 12}"
                izz="${base_mass * (base_length*base_length + base_width*base_width) / 12}"
                ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- ==================== ЛЕВОЕ КОЛЕСО ==================== -->
    
    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia 
                ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                iyy="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                izz="${wheel_mass * wheel_radius*wheel_radius / 2}"
                ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- ==================== ПРАВОЕ КОЛЕСО ==================== -->
    
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="${wheel_x_offset} ${-wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="100"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia 
                ixx="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                iyy="${wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width) / 12}"
                izz="${wheel_mass * wheel_radius*wheel_radius / 2}"
                ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>
    
    <!-- ==================== ЗАДНИЙ КАСТЕР ==================== -->
    
    <joint name="caster_joint" type="fixed">
        <origin xyz="${-wheel_x_offset} 0 ${wheel_z_offset}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="caster_link"/>
    </joint>

    <link name="caster_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- ==================== ЛИДАР ==================== -->
    
    <joint name="lidar_joint" type="fixed">
        <origin xyz="${lidar_x_offset} 0 ${lidar_z_offset}" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
    </joint>

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1.0"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${lidar_mass}"/>
            <inertia 
                ixx="${lidar_mass * (3*lidar_radius*lidar_radius + lidar_height*lidar_height) / 12}"
                iyy="${lidar_mass * (3*lidar_radius*lidar_radius + lidar_height*lidar_height) / 12}"
                izz="${lidar_mass * lidar_radius*lidar_radius / 2}"
                ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- ==================== ПЛАГИНЫ ДЛЯ GAZEBO SIM ==================== -->
    
    <!-- Плагин дифференциального привода -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>

        <!-- <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>false</publish_link_pose>
            <publish_model_pose>true</publish_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <static_update_frequency>1</static_update_frequency>
        </plugin> -->

        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <!-- Топики -->
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <tf_topic>/tf</tf_topic>
            
            <!-- Одометрия -->
            <odom_publisher_frequency>${odom_publish_frequency}</odom_publisher_frequency>            
        </plugin>
    </gazebo>

    <!-- Плагин лидара -->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>${lidar_update_rate}</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>${lidar_samples}</samples>
                        <resolution>1</resolution>
                        <min_angle>-${pi}</min_angle>
                        <max_angle>${pi}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>${lidar_min_range}</min>
                    <max>${lidar_max_range}</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>            
            <always_on>1</always_on>
        </sensor>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="left_wheel">
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
    </gazebo>
    
    <gazebo reference="caster_link">
        <mu1>0.000001</mu1>
        <mu2>0.000001</mu2>        
    </gazebo>
</robot>