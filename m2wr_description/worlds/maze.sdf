<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>

    <!-- === ОСВЕЩЕНИЕ === -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- === ФИЗИКА === -->
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- === СЦЕНА === -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- === ЗЕМЛЯ === -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- === ЛАБИРИНТ === -->
    <model name="MyMaze">
      <static>true</static>
      <pose>1.62504 1.91256 0 0 0 0</pose>
      
      <!-- Wall 0: Нижняя стена -->
      <link name="Wall_0">
        <pose>0 -2.925 0 0 0 3.14159</pose>
        <visual name="Wall_0_Visual">
          <geometry>
            <box><size>5 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_0_Collision">
          <geometry>
            <box><size>5 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 11: Верхняя стена -->
      <link name="Wall_11">
        <pose>0.70541 1.08299 0 0 0 3.14159</pose>
        <visual name="Wall_11_Visual">
          <geometry>
            <box><size>3.5 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_11_Collision">
          <geometry>
            <box><size>3.5 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 3: Левая нижняя стена -->
      <link name="Wall_3">
        <pose>-2.425 -2 0 0 0 1.5708</pose>
        <visual name="Wall_3_Visual">
          <geometry>
            <box><size>2 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_3_Collision">
          <geometry>
            <box><size>2 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 4: Горизонтальная внутренняя стена -->
      <link name="Wall_4">
        <pose>-1 -1.075 0 0 0 0</pose>
        <visual name="Wall_4_Visual">
          <geometry>
            <box><size>3 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_4_Collision">
          <geometry>
            <box><size>3 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 7: Правая стена -->
      <link name="Wall_7">
        <pose>2.425 0 0 0 0 1.5708</pose>
        <visual name="Wall_7_Visual">
          <geometry>
            <box><size>6 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_7_Collision">
          <geometry>
            <box><size>6 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 8: Верхняя стена -->
      <link name="Wall_8">
        <pose>0 2.925 0 0 0 3.14159</pose>
        <visual name="Wall_8_Visual">
          <geometry>
            <box><size>5 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_8_Collision">
          <geometry>
            <box><size>5 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Wall 9: Левая верхняя стена -->
      <link name="Wall_9">
        <pose>-2.425 0.925 0 0 0 -1.5708</pose>
        <visual name="Wall_9_Visual">
          <geometry>
            <box><size>4.15 0.15 2.5</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <collision name="Wall_9_Collision">
          <geometry>
            <box><size>4.15 0.15 2.5</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

    </model>

    <!-- === GUI НАСТРОЙКИ === -->
    <gui>
      <camera name="user_camera">
        <pose>0 0 20 0 1.57 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>